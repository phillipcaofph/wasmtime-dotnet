<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <TargetFramework Condition="'$(TestTargetFramework)' != ''">$(TestTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Wasmtime.csproj" />
    <ProjectReference Include="FiberProbe/Wasmtime.FiberProbe.csproj" ReferenceOutputAssembly="false" />
    <Compile Remove="FiberProbe/**/*.cs" />
  </ItemGroup>

  <Target Name="CopyFiberProbe" AfterTargets="Build">
    <ItemGroup>
      <FiberProbeOutput Include="FiberProbe/bin/$(Configuration)/$(TargetFramework)/*" />
    </ItemGroup>
    <Copy SourceFiles="@(FiberProbeOutput)" DestinationFolder="$(OutDir)FiberProbe" />
  </Target>

  <ItemGroup>
    <None Update="Modules/*.wat" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Components/*.wat" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Modules/hello.wat" LogicalName="hello.wat" />
    <EmbeddedResource Include="Modules/hello.wasm" LogicalName="hello.wasm" />
  </ItemGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
